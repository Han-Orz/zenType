{
  "name": "zentype",
  "version": "2.9.0",
  "description": "顺滑光标 + 打字机模式 + 涟漪聚焦 - 让写作更专注",
  "main": "index.js",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node build.js --zip",
    "test": "node tests/run.mjs",
    "build:dev": "node build.js --dev",
    "verify:prod": "node scripts/verify-prod.mjs",
    "dev": "node build.js --dev --watch",
    "link": "node scripts/make_dev_link.js",
    "clean": "rimraf dist dev *.zip",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:tests": "node node_modules/typescript/bin/tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.0.0",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.3.1",
    "rimraf": "^6.1.3",
    "sass": "^1.77.0",
    "siyuan": "^1.2.7",
    "typescript": "^5.4.0"
  }
}
